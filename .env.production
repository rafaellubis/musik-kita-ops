# ==================================================================
# Musik KITA Ops — Production Environment (.env.production)
# ==================================================================
# INSTRUKSI: Copy file ini ke .env di VPS, lalu sesuaikan nilai-nilai
# yang ditandai <GANTI_...>
#
# JANGAN commit file ini ke Git!
# ==================================================================

APP_NAME="Musik KITA Ops"
APP_ENV=production
APP_KEY=<GANTI_JALANKAN_php_artisan_key:generate>
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://<GANTI_DOMAIN_ANDA>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# === Logging — production: daily rotation, level warning ===
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# === Database — WAJIB pakai user dedicated (bukan root!) ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mk_operasional
DB_USERNAME=<GANTI_DB_USER>
DB_PASSWORD=<GANTI_DB_PASSWORD_KUAT_32_KARAKTER>

# === Session — terenkripsi, secure cookie, strict same-site ===
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=<GANTI_DOMAIN_ANDA>
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=musikita_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === Mail — konfigurasi SMTP jika ingin forgot-password aktif ===
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@<GANTI_DOMAIN_ANDA>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# === WhatsApp API — ROTASI TOKEN sebelum deploy! ===
WABLAS_TOKEN=<GANTI_TOKEN_BARU_DARI_DASHBOARD_WABLAS>
WABLAS_SECRET_KEY=<GANTI_SECRET_KEY_BARU>
WABLAS_BASE_URL=https://solo.wablas.com
WABLAS_STUDIO_WA=<GANTI_NOMOR_WA_STUDIO>

FONNTE_TOKEN=<GANTI_TOKEN_BARU_DARI_DASHBOARD_FONNTE>
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_COUNTRY_CODE=62

# === Fitur Reminder ===
SCHEDULE_REMINDER_ENABLED=false
SCHEDULE_REMINDER_MODE=day_before
SCHEDULE_REMINDER_SEND_TIME=18:00
SCHEDULE_REMINDER_HOURS_BEFORE=2

# === Laporan Sesi WA ===
SESSION_REPORT_WA_ENABLED=false
SESSION_REPORT_WA_DEBOUNCE_MINUTES=120
